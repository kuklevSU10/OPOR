# ---------------------------------------------------------------------------
# OPOR — что НЕ тащим в историю (временный/регенерируемый мусор)
# ---------------------------------------------------------------------------

# AI-инструменты и служебные временные папки
.codex_tmp_*/
.tmp_kp/
.claude/

# Временные папки синхронизации Google Drive
.tmp.drivedownload/
.tmp.driveupload/

# Рабочие прогоны и архивы логов AutoCAD (регенерируются)
рабочие_прогоны/
logs/

# Логи, локи и бэкапы AutoCAD где угодно в дереве
*.log
*.bak
*.dwl
*.dwl2

# Мусор ОС/офиса
Thumbs.db
desktop.ini
~$*

# Локальные зависимости JS и ссылки на них всегда воспроизводимы.
**/node_modules/

# OPOR_MONITOR не коммитим НИКОГДА: внутри 52-МБ cloudflared.exe.
# Один раз уже уехал в коммит через "git add -A -- релизы" и был вычищен амендом.
релизы/OPOR_MONITOR/
релизы/OPOR_MONITOR.zip

# Inno Setup: временный payload и version include собираются build_installer.ps1
installer/inno/payload/
installer/inno/version.generated.iss
